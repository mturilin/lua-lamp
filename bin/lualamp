#!/usr/bin/env bash
# Lua Lamp Application Launcher & CLI Wrapper
set -e

# Follow symlinks to locate canonical repository directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Locate native C/SDL3 engine binary
LUALAMP_BIN=""
if [ -x "$SCRIPT_DIR/bin/lualamp_bin" ]; then
  LUALAMP_BIN="$SCRIPT_DIR/bin/lualamp_bin"
elif [ -x "$SCRIPT_DIR/dist/Lua Lamp.app/Contents/MacOS/lualamp" ]; then
  LUALAMP_BIN="$SCRIPT_DIR/dist/Lua Lamp.app/Contents/MacOS/lualamp"
elif [ -x "/Applications/Lua Lamp.app/Contents/MacOS/lualamp" ]; then
  LUALAMP_BIN="/Applications/Lua Lamp.app/Contents/MacOS/lualamp"
elif command -v lualamp >/dev/null 2>&1; then
  LUALAMP_BIN="$(command -v lualamp)"
elif [ -x "$HOME/.local/bin/lualamp" ]; then
  LUALAMP_BIN="$HOME/.local/bin/lualamp"
fi

if [ -z "$LUALAMP_BIN" ] || [ ! -x "$LUALAMP_BIN" ]; then
  if [ -f "$SCRIPT_DIR/scripts/build_engine.sh" ]; then
    echo "Compiling native engine..."
    "$SCRIPT_DIR/scripts/build_engine.sh"
    LUALAMP_BIN="$SCRIPT_DIR/bin/lualamp_bin"
  fi
fi

if [ -z "$LUALAMP_BIN" ] || [ ! -x "$LUALAMP_BIN" ]; then
  echo "Error: Lua Lamp native binary not found and could not be built." >&2
  echo "Please run './scripts/build_engine.sh' or './scripts/bundle_macos_app.sh'." >&2
  exit 1
fi

export LUALAMP_USERDIR="$SCRIPT_DIR"
export LITE_USERDIR="$SCRIPT_DIR"

show_help() {
  cat << EOF
💡 Lua Lamp — Lua & SDL3 Desktop Application Platform & SDK

Usage:
  lualamp                      Launch Lua Lamp default stage
  lualamp run <dir|file>       Run a downstream application project in development mode
  lualamp build <dir> [opts]   Package a downstream project into a standalone native app
  lualamp init <dir> [name]    Scaffold a new lightweight application project
  lualamp --test               Run automated headless verification test suite
  lualamp --help, -h           Show this help message
  lualamp --version, -v        Show version information

Commands:
  run   [dir]                  Execute downstream app (looks for app.json / main.lua)
  build [dir] [--macos|--dmg|--linux]
                               Package standalone native bundle (.app, .dmg, or .tar.gz)
  init  <dir> [AppName]        Create new application scaffold with app.json and main.lua

Keyboard Controls (Default Stage):
  <Space>                      Toggle central lamp glow & beam animation
  <T>                          Toggle between Dark and Light color themes
  <Cmd+,> / <Ctrl+,>           Open modal Settings dialog
  <Click>                      Spawn radiant ripple on canvas
  <F11>                        Toggle Fullscreen mode
  <Q> / <Esc>                  Quit application
EOF
}

case "$1" in
  --help|-h)
    show_help
    exit 0
    ;;
  --version|-v)
    echo "Lua Lamp v1.0.0 (Native Lua 5.4 / SDL3 platform SDK)"
    exit 0
    ;;
  --test)
    export LUALAMP_TEST_SCRIPT="$SCRIPT_DIR/tests/test_lualamp.lua"
    exec "$LUALAMP_BIN"
    ;;
  run)
    shift
    TARGET_APP_PATH="${1:-.}"
    if [ -f "$TARGET_APP_PATH" ]; then
      TARGET_APP_DIR="$(cd "$(dirname "$TARGET_APP_PATH")" && pwd)"
    elif [ -d "$TARGET_APP_PATH" ]; then
      TARGET_APP_DIR="$(cd "$TARGET_APP_PATH" && pwd)"
    else
      echo "Error: Application directory or entry script not found: $TARGET_APP_PATH" >&2
      exit 1
    fi
    export LUALAMP_APP_DIR="$TARGET_APP_DIR"
    exec "$LUALAMP_BIN"
    ;;
  build)
    shift
    exec "$SCRIPT_DIR/scripts/package_app.sh" "$@"
    ;;
  init)
    shift
    exec "$SCRIPT_DIR/scripts/init_app.sh" "$@"
    ;;
  *)
    exec "$LUALAMP_BIN" "$@"
    ;;
esac
